{
  "name": "path-to-polish-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "content": "node scripts/prepare-content.mjs",
    "predev": "npm run content",
    "dev": "vite",
    "prebuild": "npm run content",
    "build": "tsc -b && vite build && node scripts/build-offline.mjs",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:migration": "node --test scripts/prepare-content.test.mjs",
    "check": "npm run test:migration && npm run content && npm run typecheck && npm run test && npm run build && npm run test:offline",
    "test:e2e": "playwright test",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "test:offline": "node --test scripts/build-offline.test.mjs && node --check dist/sw.js"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0",
    "@playwright/test": "^1.56.0",
    "@axe-core/playwright": "^4.10.2"
  }
}
