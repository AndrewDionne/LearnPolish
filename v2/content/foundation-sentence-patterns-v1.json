      "title": "Make a polite request",
      "cue": "Poproszę",
      "explanation": "Poproszę starts a polite request. Notice how the words after it change with what you ask for.",
      "examples": [
        {
          "sourceLesson": "Conversation_-_restaurant",
          "index": 2,
          "polish": "Poproszę wodę",
          "english": "Water, please",
          "focus": "Poproszę"
        },
        {
          "sourceLesson": "Conversation_-_restaurant",
          "index": 3,
          "polish": "Poproszę kawę",
          "english": "Coffee, please",
          "focus": "Poproszę"
        },
        {
          "sourceLesson": "Conversation_-_restaurant",
          "index": 4,
          "polish": "Poproszę herbatę",
          "english": "Tea, please",
          "focus": "Poproszę"
        },
        {
          "sourceLesson": "Conversation_-_restaurant",
          "index": 0,
          "polish": "Poproszę menu",
          "english": "May I have the menu, please?",
          "focus": "Poproszę"
        }
      ]
    },
    {
