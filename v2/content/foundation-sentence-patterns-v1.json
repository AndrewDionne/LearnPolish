    {
      "id": "permission",
      "title": "Ask if you can do something",
      "cue": "Czy mogę",
      "explanation": "Czy mogę introduces a question about whether you can do something. The action that follows changes.",
      "examples": [
        {
          "sourceLesson": "Conversation_-_shopping",
          "index": 2,
          "polish": "Czy mogę zapłacić kartą?",
          "english": "Can I pay by card?",
          "focus": "Czy mogę"
        },
        {
          "sourceLesson": "Conversation_-_shopping",
          "index": 3,
          "polish": "Czy mogę zapłacić gotówką?",
          "english": "Can I pay in cash?",
          "focus": "Czy mogę"
        },
        {
          "sourceLesson": "Conversation_-_shopping",
          "index": 15,
          "polish": "Czy mogę to przymierzyć?",
          "english": "Can I try this on?",
          "focus": "Czy mogę"
        },
        {
          "sourceLesson": "Getting_Around_1",
          "index": 16,
          "polish": "Czy mogę kupić bilet u kierowcy?",
          "english": "Can I buy a ticket from the driver?",
          "focus": "Czy mogę"
        }
      ]
    },
