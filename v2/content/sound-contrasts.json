[
  {
    "id": "contrast_c_cz_cie",
    "title": "C · CZ · Ć — Hard and soft CH sounds",
    "intro": "Three different Polish consonants. Compare each example by ear, then repeat it aloud. These are sound contrasts, not minimal pairs.",
    "groups": [
      {
        "id": "c",
        "label": "C",
        "ipa": "/t͡s/",
        "hint": "A crisp ts sound, as in the ending of English 'cats'.",
        "examples": [
          {
            "set": "Road_Terminology",
            "index": 2,
            "expected": "plac",
            "focus": "c"
          },
          {
            "set": "Road_Terminology",
            "index": 0,
            "expected": "ulica",
            "focus": "c"
          }
        ]
      },
      {
        "id": "cz",
        "label": "CZ",
        "ipa": "/t͡ʂ/",
        "hint": "A deeper, farther-back CH sound.",
        "examples": [
          {
            "set": "numbers_1-20",
            "index": 3,
            "expected": "Cztery",
            "focus": "Cz"
          },
          {
            "set": "Countries_of_the_World",
            "index": 25,
            "expected": "Czechy",
            "focus": "Cz"
          }
        ]
      },
      {
        "id": "ci",
        "label": "Ć / CI",
        "ipa": "/t͡ɕ/",
        "hint": "A softer, more forward CH sound than CZ.",
        "examples": [
          {
            "set": "numbers_1-20",
            "index": 4,
            "expected": "Pięć",
            "focus": "ć"
          },
          {
            "set": "numbers_1-20",
            "index": 5,
            "expected": "Sześć",
            "focus": "ć"
          }
        ]
      }
    ]
  },
  {
    "id": "contrast_s_sz_sie",
    "title": "S · SZ · Ś — Three SH families",
    "intro": "The plain S, deeper SZ, and softer Ś / SI are different sounds. Hear whole-word examples separately and compare.",
    "groups": [
      {
        "id": "s",
        "label": "S",
        "ipa": "/s/",
        "hint": "A clear English-style s sound.",
        "examples": [
          {
            "set": "Numbers_20-100",
            "index": 16,
            "expected": "Sto",
            "focus": "S"
          },
          {
            "set": "Countries_of_the_World",
            "index": 35,
            "expected": "Serbia",
            "focus": "S"
          }
        ]
      },
      {
        "id": "sz",
        "label": "SZ",
        "ipa": "/ʂ/",
        "hint": "A deeper, farther-back SH sound.",
        "examples": [
          {
            "set": "numbers_1-20",
            "index": 5,
            "expected": "Sześć",
            "focus": "Sz"
          },
          {
            "set": "Countries_of_the_World",
            "index": 16,
            "expected": "Szwecja",
            "focus": "Sz"
          }
        ]
      },
      {
        "id": "si",
        "label": "Ś / SI",
        "ipa": "/ɕ/",
        "hint": "A softer SH made farther forward than SZ.",
        "examples": [
          {
            "set": "Districts_of_Warszawa",
            "index": 0,
            "expected": "Śródmieście",
            "focus": "Ś"
          },
          {
            "set": "numbers_1-20",
            "index": 6,
            "expected": "Siedem",
            "focus": "Si"
          }
        ]
      }
    ]
  },
  {
    "id": "contrast_z_zh_zi",
    "title": "Z · Ż / RZ · Ź / ZI — Hear the contrast",
    "intro": "Distinguish ordinary Z from the deeper Ż/RZ and softer Ź/ZI sounds. The two spellings within each pair can represent the same phoneme.",
    "groups": [
      {
        "id": "z",
        "label": "Z",
        "ipa": "/z/",
        "hint": "Ordinary voiced z, as in English 'zoo'.",
        "examples": [
          {
            "set": "Conversation_-_shopping",
            "index": 13,
            "expected": "Za małe",
            "focus": "Z"
          },
          {
            "set": "Conversation_-_restaurant",
            "index": 12,
            "expected": "Zupa dnia",
            "focus": "Z"
          }
        ]
      },
      {
        "id": "zh",
        "label": "Ż / RZ",
        "ipa": "/ʐ/",
        "hint": "A deeper zh sound, spelled Ż or RZ in these examples.",
        "examples": [
          {
            "set": "Districts_of_Warszawa",
            "index": 5,
            "expected": "Żoliborz",
            "focus": "Ż"
          },
          {
            "set": "The_Cities_of_Poland",
            "index": 16,
            "expected": "Rzeszów",
            "focus": "Rz"
          }
        ]
      },
      {
        "id": "zi",
        "label": "Ź / ZI",
        "ipa": "/ʑ/",
        "hint": "A softer, more forward zh sound than Ż/RZ.",
        "examples": [
          {
            "set": "The_Cities_of_Poland",
            "index": 22,
            "expected": "Zielona Góra",
            "focus": "Zi"
          },
          {
            "set": "Names_of_Poland_1",
            "index": 8,
            "expected": "Mateusz Woźniak",
            "focus": "ź"
          }
        ]
      }
    ]
  },
  {
    "id": "contrast_l_lstroked",
    "title": "L · Ł — A different letter, a different sound",
    "intro": "Polish L is a clear L sound, while modern Polish Ł is pronounced like English W.",
    "groups": [
      {
        "id": "l",
        "label": "L",
        "ipa": "/l/",
        "hint": "Touch your tongue behind your upper teeth.",
        "examples": [
          {
            "set": "The_Cities_of_Poland",
            "index": 8,
            "expected": "Lublin",
            "focus": "L"
          },
          {
            "set": "The_Cities_of_Poland",
            "index": 26,
            "expected": "Legnica",
            "focus": "L"
          }
        ]
      },
      {
        "id": "lstroked",
        "label": "Ł",
        "ipa": "/w/",
        "hint": "Round your lips like the English W in 'water'.",
        "examples": [
          {
            "set": "The_Cities_of_Poland",
            "index": 2,
            "expected": "Łódź",
            "focus": "Ł"
          },
          {
            "set": "Countries_of_the_World",
            "index": 29,
            "expected": "Łotwa",
            "focus": "Ł"
          }
        ]
      }
    ]
  },
  {
    "id": "contrast_krzy_przy",
    "title": "KRZY · PRZY — Polish consonant clusters",
    "intro": "Hear the krzy and przy combinations inside recorded Polish phrases, then try repeating them. These are whole-phrase examples, not isolated syllable recordings.",
    "groups": [
      {
        "id": "krzy",
        "label": "KRZY",
        "ipa": "/kʂɨ/",
        "hint": "After k, rz is normally devoiced. Focus on the krzy part within each spoken example.",
        "examples": [
          {
            "set": "Road_Terminology",
            "index": 19,
            "expected": "ulica Świętokrzyska",
            "focus": "krzy"
          },
          {
            "set": "Names_of_Poland_1",
            "index": 2,
            "expected": "Krzysztof Wiśniewski",
            "focus": "Krzy"
          }
        ]
      },
      {
        "id": "przy",
        "label": "PRZY",
        "ipa": "/pʂɨ/",
        "hint": "A related cluster: p followed by devoiced rz and Polish y. Compare the beginning of each example.",
        "examples": [
          {
            "set": "Transit_1",
            "index": 8,
            "expected": "Przystanek autobusowy",
            "focus": "Przy"
          },
          {
            "set": "Conversation_-_shopping",
            "index": 15,
            "expected": "Czy mogę to przymierzyć?",
            "focus": "przy"
          }
        ]
      }
    ]
  }
]
