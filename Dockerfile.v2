# FREE Render V2: one build artifact, one Flask web host. No persistent user DB.
FROM node:22-bookworm-slim AS frontend
WORKDIR /repo
COPY docs/sets/ docs/sets/
COPY docs/static/ docs/static/
COPY v2/content/ v2/content/
COPY v2/frontend/ v2/frontend/
RUN cd v2/frontend && npm install --no-audit --no-fund
# Default public preview: no live family accounts until verified Neon + email.
# Build arg is a NON-SECRET UI feature flag, not a Postgres/Resend credential.
# When the live API and recovery emails are verified use same-origin.
ARG PTP_FAMILY_UI_MODE=offline
RUN cd v2/frontend && \
    if [ "$PTP_FAMILY_UI_MODE" = "same-origin" ]; then \
      VITE_FAMILY_API_URL=same-origin VITE_SPEECH_ASSESSMENT_ENABLED=false npm run build; \
    elif [ "$PTP_FAMILY_UI_MODE" = "offline" ]; then \
      VITE_FAMILY_API_URL= VITE_SPEECH_ASSESSMENT_ENABLED=false npm run build; \
    else \
      echo "Invalid PTP_FAMILY_UI_MODE" >&2; exit 1; \
    fi

FROM python:3.11-slim AS runtime
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PTP_RENDER_FAMILY_MODE=disabled \
    PTP_SPEECH_ENABLED=0
WORKDIR /srv/ptp
# libpq verify-full requires a CA trust source. Debian slim does not
# guarantee ~/.postgresql/root.crt; install an explicit system bundle.
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    && update-ca-certificates \
    && rm -rf /var/lib/apt/lists/*
RUN test -s /etc/ssl/certs/ca-certificates.crt
RUN pip install --no-cache-dir "Flask==3.1.1" "gunicorn>=23,<25" "psycopg[binary]>=3.2,<4"
COPY v2/server/ /srv/ptp/v2/server/
COPY --from=frontend /repo/v2/frontend/dist/ /srv/ptp/v2/frontend/dist/
WORKDIR /srv/ptp/v2/server
EXPOSE 10000
# HTTP server binds only once all frontend assets and the V2 app have loaded.
CMD ["sh", "-c", "exec gunicorn -w 1 --threads 4 --timeout 120 --bind 0.0.0.0:${PORT:-10000} render_wsgi:app"]
